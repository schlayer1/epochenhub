/**
 * Historische Dilemma- & Ratsentscheidungen für Geschichtsspiele
 * Drop-in Datenstruktur für schülergerechte, handlungsorientierte Entscheidungen.
 */

export interface DilemmaOption {
  id: string;
  title: string;
  argumentText: string;
  rewards: Record<string, number>; // Konkrete Rohstoffe (z. B. { wheat: 15, wood: 8 })
  storyFlag: string;               // Flag für Folgedialoge (z. B. 'ch3_grain_distributed')
  feedbackText: string;           // Pädagogisches Feedback nach der Entscheidung
}

export interface DilemmaDef {
  id: string;
  chapter: number;
  councilTitle: string;            // z. B. 'Pharaonen-Rat von Memphis', 'Thing der freien Germanen', 'Römischer Senat'
  mentorSpeaker: string;           // Name des Mentors/Vorsitzenden
  illustrationKey: string;         // Referenz auf Grafik/Icon
  conflictTitle: string;
  conflictText: string;            // Kindgerecht geschildertes Dilemma (Klasse 5-8)
  options: DilemmaOption[];
}

