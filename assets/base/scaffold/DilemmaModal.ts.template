/**
 * Dilemma- & Ratsentscheidungs-Modal (DOM-Overlay)
 * Präsentiert historische Konflikte, visualisiert Argumente und schüttet Ressourcen aus.
 */

import { DilemmaDef, DilemmaOption } from '../data/dilemmas';

export class DilemmaModal {
  private el: HTMLElement;
  private currentDilemma: DilemmaDef | null = null;
  private onChosenCallback: ((opt: DilemmaOption) => void) | null = null;

  constructor() {
    this.el = document.createElement('div');
    this.el.id = 'dilemma-modal';
    this.el.className = 'dilemma-overlay';
    this.el.style.display = 'none';
    document.body.appendChild(this.el);
    this.injectStyles();
  }

  public open(dilemma: DilemmaDef, onChosen: (opt: DilemmaOption) => void): void {
    this.currentDilemma = dilemma;
    this.onChosenCallback = onChosen;
    this.render();
    this.el.style.display = 'flex';
  }

  public close(): void {
    this.el.style.display = 'none';
    this.currentDilemma = null;
  }

  private render(): void {
    if (!this.currentDilemma) return;
    const d = this.currentDilemma;

    this.el.innerHTML = `
      <div class="dilemma-card">
        <div class="dilemma-header">
          <span class="dilemma-badge">🏛️ ${d.councilTitle}</span>
          <span class="dilemma-speaker">Vorsitz: <strong>${d.mentorSpeaker}</strong></span>
        </div>
        <h2 class="dilemma-title">${d.conflictTitle}</h2>
        <div class="dilemma-body">
          <p class="dilemma-text">${d.conflictText}</p>
        </div>
        <div class="dilemma-prompt">⚖️ Dein Schiedsspruch als Chronist: Wie entscheidest du?</div>
        <div class="dilemma-options">
          ${d.options.map((opt, i) => `
            <button class="dilemma-opt-btn" data-index="${i}">
              <div class="opt-head">
                <span class="opt-num">Option ${i + 1}</span>
                <strong class="opt-title">${opt.title}</strong>
              </div>
              <p class="opt-arg">„${opt.argumentText}“</p>
              <div class="opt-rewards">
                🎁 <strong>Ertrag für die Siedlung:</strong> 
                ${Object.entries(opt.rewards).map(([k, v]) => `+${v} ${k}`).join(', ')}
              </div>
            </button>
          `).join('')}
        </div>
      </div>
    `;

    this.el.querySelectorAll('.dilemma-opt-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.index || '0', 10);
        const opt = d.options[idx];
        this.selectOption(opt);
      });
    });
  }

  private selectOption(opt: DilemmaOption): void {
    // Erfolgs-Feedback rendern
    this.el.innerHTML = `
      <div class="dilemma-card dilemma-feedback-card">
        <div class="dilemma-badge">⚖️ Schiedsspruch verkündet!</div>
        <h2>${opt.title}</h2>
        <p class="feedback-desc">${opt.feedbackText}</p>
        <div class="reward-box">
          <h3>📦 Deinem Vorrat hinzugefügt:</h3>
          <div class="reward-chips">
            ${Object.entries(opt.rewards).map(([k, v]) => `
              <span class="reward-chip">+${v} ${k}</span>
            `).join('')}
          </div>
        </div>
        <button id="dilemma-confirm-btn" class="dilemma-btn-primary">Weiter zur Mission</button>
      </div>
    `;

    document.getElementById('dilemma-confirm-btn')?.addEventListener('click', () => {
      if (this.onChosenCallback) {
        this.onChosenCallback(opt);
      }
      this.close();
    });
  }

  private injectStyles(): void {
    const style = document.createElement('style');
    style.textContent = `
      .dilemma-overlay {
        position: fixed;
        inset: 0;
        z-index: 35;
        background: rgba(10, 8, 16, 0.85);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        box-sizing: border-box;
      }
      .dilemma-card {
        background: #fdf6e3;
        color: #2c2518;
        border: 2px solid #b45309;
        border-radius: 8px;
        box-shadow: 0 12px 36px rgba(0,0,0,0.7);
        max-width: 640px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        padding: 24px;
        box-sizing: border-box;
        font-family: system-ui, -apple-system, sans-serif;
      }
      .dilemma-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        border-bottom: 1px solid rgba(180, 83, 9, 0.3);
        padding-bottom: 8px;
        font-size: 13px;
      }
      .dilemma-badge {
        font-weight: 700;
        color: #92400e;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .dilemma-title {
        font-size: 20px;
        margin: 0 0 12px 0;
        color: #78350f;
        line-height: 1.3;
      }
      .dilemma-text {
        font-size: 14px;
        line-height: 1.6;
        color: #451a03;
        margin-bottom: 16px;
      }
      .dilemma-prompt {
        font-weight: 700;
        font-size: 14px;
        color: #b45309;
        margin-bottom: 12px;
      }
      .dilemma-options {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .dilemma-opt-btn {
        background: #fff;
        border: 1px solid #d97706;
        border-radius: 6px;
        padding: 14px;
        text-align: left;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .dilemma-opt-btn:hover {
        background: #fef3c7;
        border-color: #b45309;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(180, 83, 9, 0.15);
      }
      .opt-head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
      }
      .opt-num {
        background: #d97706;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
      }
      .opt-title {
        font-size: 15px;
        color: #78350f;
      }
      .opt-arg {
        font-size: 13px;
        font-style: italic;
        color: #78350f;
        margin: 0 0 8px 0;
      }
      .opt-rewards {
        font-size: 12px;
        color: #15803d;
        background: #f0fdf4;
        padding: 4px 8px;
        border-radius: 4px;
        border: 1px solid #bbf7d0;
      }
      .dilemma-feedback-card {
        text-align: center;
      }
      .feedback-desc {
        font-size: 15px;
        line-height: 1.6;
        color: #451a03;
        margin: 16px 0;
      }
      .reward-box {
        background: #fef3c7;
        border: 1px solid #f59e0b;
        border-radius: 6px;
        padding: 12px;
        margin: 16px 0;
      }
      .reward-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        margin-top: 8px;
      }
      .reward-chip {
        background: #15803d;
        color: #fff;
        font-weight: 700;
        font-size: 13px;
        padding: 4px 10px;
        border-radius: 12px;
      }
      .dilemma-btn-primary {
        background: #d97706;
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 6px;
        padding: 10px 24px;
        font-size: 14px;
        cursor: pointer;
        margin-top: 8px;
      }
      .dilemma-btn-primary:hover {
        background: #b45309;
      }
    `;
    document.head.appendChild(style);
  }
}
