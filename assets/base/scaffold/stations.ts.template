/**
 * 12-Archetypen Didaktik-Pool für Haptische Mitmach-Stationen & Interaktive Minispiele
 * Heimbürgeschule Kahla – Epochenhub Retro Games
 * 
 * Jedes Spiel wählt genau 5 passende Stationen aus diesem 12er-Pool,
 * um maximale Abwechslung für Schüler bei mehreren Epochenspielen zu garantieren!
 */

export type StationType =
  | 'mortar_crafting'     // 1. Mischen & Mahlen (Kräutermörser, Farben, Salben, Mehl)
  | 'forge_rhythm'        // 2. Schmieden & Hämmern (Rhythmisches Hämmern am Amboss, Kupfer treiben)
  | 'sorting_balance'     // 3. Zuordnen & Kategorisieren (Zehntabgaben, Erntegüter, Werkzeuge)
  | 'scale_weighing'      // 4. Balkenwaage & Handeln (Kupfer-Deben, Silberdenare, Gewichte austarieren)
  | 'sealing_diplomacy'   // 5. Urkunden & Siegeln (Siegelwachs schmelzen, Petschaft aufdrücken)
  | 'crop_rotation'       // 6. Zyklus & Landwirtschaft (Dreifelderwirtschaft, Nil-Überflutung, Saat/Ernte)
  | 'excavation_brush'    // 7. Archäologische Ausgrabung (Pinselabstrich bei Bodenschichten)
  | 'arch_construction'  // 8. Baukunst & Statik (Schlussstein setzen, Rundbogen/Fachwerk bauen)
  | 'chronology_timeline' // 9. Zeitstrahl-Schieber (Prozess- und Geschichtsschritte ordnen)
  | 'symbol_decoder'      // 10. Schrift & Entzifferung (Hieroglyphen, Runen, Latein decodieren)
  | 'tribunal_vote'       // 11. Historischer Rat & Urteil (Thing-, Senats- oder Zunftabstimmung)
  | 'astronomy_dial';     // 12. Gestirne & Kalender (Sonnenuhr, Nebra-Himmelscheibe ausrichten)

export interface StationDef {
  id: string;
  type: StationType;
  title: string;
  subtitle?: string;
  mentorSpeaker: string;
  instructionText: string;
  historicalContext: string;
  chapter: number;
  config: Record<string, any>;
  rewardItem: string;
  rewardQty: number;
  rewardPoints: number;
}

