 * Haptische Mini-Stationen & Interaktive Puzzles
 * Standardisierte Vorlagen für epochenspezifische handlungsorientierte Minispiele.
 */

export type StationType = 'scale' | 'decoder' | 'brush' | 'sluice';

export interface StationDef {
  id: string;
  type: StationType;
  title: string;
  mentorSpeaker: string;
  instructionText: string; // Schülergerechte Anleitung
  historicalContext: string;
  chapter: number;
  config: any; // Puzzlespezifische Konfiguration (z. B. Zielgewichte, Runenpaare, Schleusen-Ausrichtung)
  rewardItem: string;
  rewardQty: number;
}

